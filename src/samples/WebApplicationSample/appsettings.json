{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MPassSample": {
    "PendingRequestLifetime": "00:30:00"
  },
  "MPassSamlOptions": {
    "SamlRequestIssuer": "https://localhost:5001",
    "SamlServiceLoginDestination": "https://localhost:5001/account/acs",
    "SamlServiceLogoutDestination": "https://localhost:5001/account/logout-callback",
    "SamlServiceSingleLogoutDestination": "https://localhost:5001/account/slo",
    "ServiceCertificatePath": "certs/sp.pfx",
    "IdentityProviderCertificatePath": "certs/mpass-idp.cer",
    "IdentityProviderIssuer": "__SET_FROM_MPASS_IDP_METADATA_ENTITYID__",
    "SamlLoginDestination": "https://MPassHostName.md/login/saml",
    "SamlLogoutDestination": "https://MPassHostName.md/logout/saml",
    "SamlMessageTimeout": "00:10:00",
    "SamlClockSkew": "00:02:00",
    "AllowSha1Signatures": false,
    "SamlMessageMaxLength": 262144
  }
}
